# Talantix OAuth access token from the administrator token JSON.
TALANTIX_ACCESS_TOKEN=

# Optional but recommended. The service can refresh access_token automatically.
TALANTIX_REFRESH_TOKEN=

# Optional token JSON path. If set, refreshed access/refresh tokens are persisted here.
# The file format matches Talantix token JSON: access_token, refresh_token, expires_in, created_at.
TALANTIX_TOKEN_FILE=.talantix_tokens.json

# Talantix asks to provide a User-Agent with company/contact information.
TALANTIX_USER_AGENT=HR Link BI Integration (it@example.com)

# Optional key protecting this service for Power BI calls.
# Pass it as X-API-Key header or api_key query parameter.
SERVICE_API_KEY=

# Optional bearer token for Power BI. Later this can be replaced by a real JWT validator.
# Pass it as Authorization: Bearer <token>.
POWERBI_BEARER_TOKEN=

# Defaults are safe for Power BI and Talantix pagination limits.
TALANTIX_PAGE_SIZE=20
TALANTIX_VACANCY_PAGE_SIZE=50
# Empty means no artificial cap: paginate until Talantix returns hasNextPage=false.
TALANTIX_MAX_PAGES=
TALANTIX_CONCURRENCY=5

# Background BI cache refresh.
SYNC_ENABLED=true
SYNC_ON_STARTUP=true
SYNC_INTERVAL_SECONDS=3600
BI_CACHE_FILE=data/talantix_bi_export.json
BI_SYNC_PAGE_SIZE=20
BI_SYNC_PERSON_PAGE_SIZE=5
# Optional limits for initial testing. Leave empty in production to collect all pages/stages.
BI_SYNC_MAX_PAGES=
BI_SYNC_MAX_STAGES=
BI_SYNC_HISTORY_FIRST=20
